    "test": "pnpm --filter @paugeran/web test",
    "build:server": "cargo build --release --bin paugeran",
    "test:server": "cargo test"
  },
  "packageManager": "pnpm@9.1.0",
  "engines": { "node": ">=20.0.0" }
}
