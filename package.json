{
  "name": "paugeran",
  "version": "0.1.0",
  "private": true,
  "description": "Supreme Legal Reasoning Engine for Indonesian Law",
  "scripts": {
    "dev": "pnpm --filter @paugeran/web dev",
    "build": "pnpm --filter @paugeran/web build",
